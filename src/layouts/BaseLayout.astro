---
const { title = "Ryan Darius Lim - Portfolio" } = Astro.props;
import "../styles/global.css";
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const withBase = (path = "") => `${baseWithSlash}${path}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>
<body>
    <!-- Navigation -->
    <nav>
        <div class="nav-container">
            <a href={withBase()} class="nav-brand" style="text-decoration: none; color: #1a1a1a;">Ryan Darius Lim</a>
            <div class="nav-links">
                <a href={withBase()} class="nav-link">Home</a>
                <a href={withBase("experience")} class="nav-link">Experience</a>
                <a href={withBase("projects")} class="nav-link">Projects</a>
                <a href={withBase("leadership")} class="nav-link">Leadership</a>
                <a href={withBase("accolades")} class="nav-link">Accolades</a>
                <a href={withBase("about")} class="nav-link">About</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <slot />

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <p class="footer-quote">
                    🕊️ ✨ 🙏
                </p>
                
                <div class="footer-links">
                    <a href="mailto:ryandarius@u.nus.edu" class="footer-link">📧 Email</a>
                    <a href="https://linkedin.com/in/ryan-darius-lim/" target="_blank" class="footer-link">💼 LinkedIn</a>
                </div>
                <br>
                <p class="footer-quote">
                    Copyright © Ryan Darius Lim 2025
                </p>
            </div>
        </div>
    </footer>
</body>
</html>
