---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Ryan Darius Lim - Portfolio">
    <header>
        <div class="container">
            <div class="header-main">
                <div class="header-logos">
                    <img src="/nus-computing.png" alt="NUS Computing logo" class="school-logo">
                    <img src="/noc.png" alt="NUS Overseas Colleges logo" class="school-logo">
                </div>
                <div class="header-text">
                    <h1>Ryan Darius Lim</h1>
                    <p class="tagline">Fintech | UIUX | Analytics</p>
                    <p class="university">Business Analytics @ National University of Singapore (School of Computing)<br>NUS Overseas Colleges (Paris) Alumnus<br>Vice President @ NUS Fintech Society</p>
                </div>
                <div class="header-photo">
                    <img src="/MyPhoto.png" alt="Ryan Darius Lim">
                </div>
            </div>

            <div class="contact-boxes">
                <a href="mailto:ryandarius@u.nus.edu" class="contact-box">
                    <div class="contact-icon">📧</div>
                    <div class="contact-text">ryandarius@u.nus.edu OR ryanlim711@gmail.com</div>
                </a>
                <a href="https://linkedin.com/in/ryan-darius-lim/" target="_blank" class="contact-box">
                    <div class="contact-icon"><img src="/linkedin_logo.png" alt="LinkedIn"></div>
                    <div class="contact-text">ryan-darius-lim</div>
                </a>
                <a href="tel:+6587747874" class="contact-box">
                    <div class="contact-icon">📱</div>
                    <div class="contact-text">+65 8774 7874</div>
                </a>
            </div>

            <div class="quick-info">
                <div class="info-item">
                    <div class="info-value">4.64/5.00</div>
                    <div class="info-label">GPA</div>
                </div>
                <div class="info-item">
                    <div class="info-value">May 2027</div>
                    <div class="info-label">Expected Graduation</div>
                </div>
                <div class="info-item">
                    <div class="info-value">🇸🇬</div>
                    <div class="info-label">Singapore Citizen</div>
                </div>
            </div>

            <div class="quick-info" style="margin-top: 15px;">
                <div class="info-item">
                    <div class="info-value">🇬🇧</div>
                    <div class="info-label">English (Native)</div>
                </div>
                <div class="info-item">
                    <div class="info-value">🇨🇳</div>
                    <div class="info-label">Mandarin Chinese (Professional)</div>
                </div>
                <div class="info-item">
                    <div class="info-value">🇫🇷</div>
                    <div class="info-label">French (Basic)</div>
                </div>
            </div>
        </div>
    </header>

    <!-- Quick Overview Section -->
    <div class="section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Overview</h2>
                <p class="section-subtitle">A snapshot of my professional journey</p>
            </div>

            <div class="experience-grid">
                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">Professional Experience</div>
                            <div class="exp-company">5 Internships across Fintech, AI, E-commerce, Insurance & Reinsurance</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>From AI startups in Paris to global financial institutions, I've built expertise in product analytics, UX optimization, and business operations across diverse industries.</p>
                        <a href="/experience" style="color: #0366d6; font-weight: 600; margin-top: 10px; display: inline-block;">View Full Experience →</a>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">Projects</div>
                            <div class="exp-company">Kleep AI, Shopee, NUS Fintech Summit, MealMate</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Projects (personal and professional) showcasing my approach to user research, data-driven design decisions, and creating impactful products.</p>
                        <a href="/projects" style="color: #0366d6; font-weight: 600; margin-top: 10px; display: inline-block;">View Projects →</a>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">Leadership</div>
                            <div class="exp-company">Vice President @ NUS Fintech Society</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Leading a 200-member society, winning case competitions (BofA, BCG Emeralds), and receiving the NUS Global Merit Scholarship.</p>
                        <a href="/leadership" style="color: #0366d6; font-weight: 600; margin-top: 10px; display: inline-block;">View Leadership →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Skills -->
    <div class="section" style="background: #f8f9fa;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Core Competencies</h2>
            </div>

            <div class="skills-grid">

                <div class="skill-category">
                    <h3>📊 Data Analytics and Visualisation</h3>
                    <ul>
                        <li>SQL, Google Analytics 4</li>
                        <li>Power BI, Tableau, Looker</li>
                        <li>Python, R, Excel (VBA)</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>💻 Product and Engineering </h3>
                    <ul>
                        <li>Frameworks: Vue.js, Streamlit</li>
                        <li>Java, HTML/CSS/JS</li>
                        <li>Git & Version Control</li>
                        <li>API Integration</li>
                        <li>A/B Testing</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>📦 Strategy and Business</h3>
                    <ul>
                        <li>Revenue and cost optimisation</li>
                        <li>Stakeholder Management</li>
                        <li>Business Development</li>
                        <li>Social Media Marketing</li>
                    </ul>
                </div>
            </div>

            <div style="text-align: center; margin-top: 30px;">
                <a href="/accolades" style="display: inline-block; background: #0366d6; color: white; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 600;">View Accolades →</a>
            </div>
        </div>
    </div>
</BaseLayout>
