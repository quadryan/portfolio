---
import BaseLayout from '../layouts/BaseLayout.astro';
const withBase = (path) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
---

<BaseLayout title="Projects - Ryan Darius Lim">
    <div class="section" style="padding-top: 80px;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Projects</h2>
                <p class="section-subtitle">UX case studies and software engineering work</p>
            </div>

            <!-- UX Projects -->
            <div class="section-header" style="margin-top: 40px;">
                <h3 class="section-title" style="font-size: 1.6rem;">UX Projects</h3>
            </div>

            <div class="experience-grid">
                <div class="experience-card">
                    <div class="exp-header">
                        <img src={withBase("kleep_logo.png")} alt="Kleep logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Kleep AI - Startup Website + App UX</div>
                            <div class="exp-company">Founders' Associate (Product & Operations)</div>
                            <div class="exp-dates">Jan 2025 – Jun 2025 | NOC Paris</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Revamped the entire startup website using Framer and designed customized app interfaces in Figma for fashion e-commerce clients. Used Google Analytics to identify UX friction points and improve conversion rates.</p>
                        <a href={withBase("projects/kleep")} style="color: #0366d6; font-weight: 600; margin-top: 10px; display: inline-block;">View Full Case Study →</a>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <img src={withBase("shopee_logo.png")} alt="Shopee logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Shopee - Returns & Refunds UX Optimization</div>
                            <div class="exp-company">Operations Business Analyst Intern</div>
                            <div class="exp-dates">Jun 2025 – Aug 2025</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Used SQL data analysis and competitive benchmarking to streamline RR entry points, potentially reducing compensation costs by up to 10%. Conducted UX audits across multiple e-commerce platforms.</p>
                        <a href={withBase("projects/shopee")} style="color: #0366d6; font-weight: 600; margin-top: 10px; display: inline-block;">View Full Case Study →</a>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <img src={withBase("fintech_logo.png")} alt="NUS Fintech Society logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">NUS Fintech Summit 2025 - Visual Design & Marketing</div>
                            <div class="exp-company">Vice President</div>
                            <div class="exp-dates">2024 – 2025</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Led visual design and marketing campaign for major fintech conference, creating cohesive brand identity that doubled sign-ups and secured $135,000 in sponsorships.</p>
                        <a href={withBase("projects/fintech-summit")} style="color: #0366d6; font-weight: 600; margin-top: 10px; display: inline-block;">View Full Case Study →</a>
                    </div>
                </div>
            </div>

            <!-- Software Engineering Projects -->
            <div class="section-header" style="margin-top: 60px;">
                <h3 class="section-title" style="font-size: 1.6rem;">Software Engineering</h3>
            </div>

            <div class="experience-grid">
                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">🍽️ MealMate - AI Meal Planning App</div>
                            <div class="exp-company">Full-Stack Developer + Product Designer</div>
                            <div class="exp-dates">2024 – Present</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Intelligent web application combining AI-driven recipe generation, real-time inventory tracking, and nutritional insights. Built with Vue.js, Firebase, and integrated with Gemini AI.</p>
                        <a href={withBase("projects/mealmate")} style="color: #0366d6; font-weight: 600; margin-top: 10px; display: inline-block;">View Project Details →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
