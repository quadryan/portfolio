---
import BaseLayout from '../layouts/BaseLayout.astro';
const withBase = (path) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
---

<BaseLayout title="Accolades - Ryan Darius Lim">
    <div class="section" style="padding-top: 80px;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Accolades </h2>
                <p class="section-subtitle">Academic achievements, case competitions, and honors</p>
            </div>

            <div class="experience-grid">
                <!-- BofA -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src={withBase("bofa.png")} alt="Bank of America" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">BofA Global Payments Solutions Case Challenge 2025</div>
                            <div class="exp-company">1st Runners-Up</div>
                            <div class="exp-dates">Oct 2025</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Issued by Bank of America
                    </div>
                    <div class="exp-content">
                        <p><strong>Problem statement (13 October 2025):</strong></p>
                        <p>Perform a competitor analysis between traditional banks and fintech/paytech disruptors in the payments space. Based on your findings, propose a strategic roadmap for how traditional banks can adapt, compete, and thrive in the evolving payments industry. Your presentation should also explore and discuss alternative new payment rails e.g., stablecoin, CBDCs, etc.</p>
                        <br>
                        <p>Proposed a partnership strategy with fintech players like Airwallex (local payment settlement systems) to accelerate real-time settlement, reduce cost, and strengthen customer experience.</p>
                        <p><strong>Group:</strong> 2</p>
                    </div>
                </div>

                <!-- BCG -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src={withBase("bcg.png")} alt="BCG Emeralds" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">BCG Emeralds Southeast Asia 2025</div>
                            <div class="exp-company">Completed</div>
                            <div class="exp-dates">July 2025</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Issued by The Boston Consulting Group
                    </div>
                    <div class="exp-content">
                        <p>Selected to join BCG Emeralds, an exclusive training programme providing hands-on exposure to consulting frameworks, problem-solving drills, and real-world strategy insights.</p>
                        <br>
                        <p>Networked and collaborated with project leaders, associates, and fellow peers in simulated case scenarios, sharpening analytical thinking, business intuition, and structured communication.</p>
                    </div>
                    <div class="project-image">
                        <img src={withBase("bcg-emeralds.png")} alt="BCG Emeralds certificate">
                    </div>
                </div>

                <!-- NUS SDS Datathon -->
                <div class="experience-card">
                    <div class="exp-header">
                    <img src={withBase("nus-logo.png")} alt="NUS Statistics and Data Society" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">NUS SDS Data Visualisation Competition 2024</div>
                            <div class="exp-company">1st Runners-Up</div>
                            <div class="exp-dates">Sep 2024</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Issued by NUS Statistics and Data Science Society
                    </div>
                    <div class="exp-content">
                        <p><strong>Theme:</strong> Data Decades, 80s Hits Parade</p>
                        <p><strong>Time constraint:</strong> 2 hours</p>
                    </div>
                    <div class="project-image">
                        <img src={withBase("sds-winner.png")} alt="SDS Datathon award">
                    </div>
                    <div class="project-image">
                        <img src={withBase("nus-sds.png")} alt="SDS Datathon visualization">
                    </div>
                    <p style="margin-top: 10px; color: #586069;">
                        Our visualisation, showing findings on how high tempo and danceability songs tend to be more popular in the 80s till now.
                    </p>
                </div>

                <!-- NUS Fintech Summit Hackathon -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src={withBase("fintech_logo.png")} alt="NUS Fintech Society" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">NUS Fintech Summit Hackathon 2024</div>
                            <div class="exp-company">1st Runners-Up</div>
                            <div class="exp-dates">Jan 2024</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Issued by National University of Singapore
                    </div>
                    <div class="exp-content">
                        <p><strong>Problem statement by Northern Trust Corp (19 January 2024):</strong></p>
                        <p>How might we rethink the interoperability of tokens to enable seamless and secure movement of digital assets across chains, unlocking diverse liquidity pools for financial institutions to reshape the digital assets trading landscape?</p>
                        <p><strong>Team:</strong> Northern Star</p>
                    </div>
                    <div class="project-image">
                        <img src={withBase("nus-fintech-summit-2024.png")} alt="NUS Fintech Summit team photo">
                    </div>
                </div>

                <!-- NES Ground Zero -->
                <div class="experience-card">
                    <div class="exp-header">
                    <img src={withBase("nus-logo.png")} alt="NUS Entrepreneurship Society" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Best Team Synergy Award, NES Ground Zero 2023</div>
                            <div class="exp-company">Finalist & Honourable Mention</div>
                            <div class="exp-dates">May 2023</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Issued by National University of Singapore
                    </div>
                    <div class="exp-content">
                        <p><strong>Team Jalan Journey:</strong> An edutech social enterprise startup focused on educational accessibility.</p>
                        <p>Startup competition finalist at Mapletree Business Centre (13 May 2023)</p>
                        <p><a href="https://www.linkedin.com/company/jalanjourney/" target="_blank" style="color: #0366d6;">View Company →</a></p>
                    </div>
                    <div class="project-image">
                        <img src={withBase("jj-me.png")} alt="Presenting at NES Ground Zero">
                    </div>
                    <div class="project-image" style="margin-top: 15px;">
                        <img src={withBase("team-jj.png")} alt="Team Jalan Journey">
                    </div>
                </div>
                
                <!-- NUS Global Merit Scholarship -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src={withBase("nus-computing.png")} alt="NUS Computing" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">NUS Global Merit Scholarship</div>
                            <div class="exp-company">Bond-Free Full Ride Scholarship</div>
                            <div class="exp-dates">May 2023</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Issued by the National University of Singapore
                    </div>
                    <div class="exp-content">
                        <p>Bond-free full ride scholarship awarded to a select few exceptional students.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
