---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Skills & Leadership - Ryan Darius Lim">
    <!-- SKILLS SECTION -->
    <div class="section" style="padding-top: 80px; background: #f8f9fa;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Technical Skills</h2>
            </div>

            <div class="skills-grid">
                <div class="skill-category">
                    <h3>Design & UX</h3>
                    <ul>
                        <li>Figma (UI/UX Design)</li>
                        <li>User Flow Analysis</li>
                        <li>Competitive Benchmarking</li>
                        <li>User Journey Mapping</li>
                        <li>Wireframing & Prototyping</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>Analytics & Data</h3>
                    <ul>
                        <li>SQL - MySQL, SQL Server, NoSQL</li>
                        <li>Google Analytics 4</li>
                        <li>Power BI & Tableau</li>
                        <li>Looker</li>
                        <li>Excel (Advanced, VBA)</li>
                        <li>Python, R</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>Technical</h3>
                    <ul>
                        <li>HTML, CSS, JavaScript</li>
                        <li>Vue.js</li>
                        <li>Git & Version Control</li>
                        <li>Java</li>
                        <li>Shopify API Integration</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>Product</h3>
                    <ul>
                        <li>Product Analytics</li>
                        <li>A/B Testing</li>
                        <li>Client Management</li>
                        <li>Stakeholder Communication</li>
                        <li>Project Management</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>Business Skills</h3>
                    <ul>
                        <li>Sales and BD</li>
                        <li>Leadership and People Management</li>
                        <li>Social Media Marketing</li>
                        <li>Powerpoint Sliding</li>
                        <li>Presenting</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- LEADERSHIP SECTION -->
    <div class="section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Leadership & Activities</h2>
            </div>

            <div class="experience-grid">
                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/fintech_logo.png" alt="NUS Fintech Society logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Vice President</div>
                            <div class="exp-company">NUS Fintech Society (NFS)</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <ul>
                            <li>Spearheaded NFS, a 200-member society bridging fintech with students; increased tech project success rate by 30%.</li>
                            <li>Developed industry sponsorships ($135,000), strategized a marketing campaign (2x sign-ups) for NUS Fintech Summit 2025.</li>
                        </ul>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/nus-global.png" alt="NUS Global logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Global Exchange Buddy</div>
                            <div class="exp-company">NUS Global Relations Office</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <ul>
                            <li>Befriended and assimilated exchange students from Europe and America, introducing them to Singapore and NUS.</li>
                            <li>Conducted food and heritage tours around Singapore, especially to our local delights.</li>
                        </ul>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/saf-logo.png" alt="SAF logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Brigade Signal Officer (Lieutenant)</div>
                            <div class="exp-company">Singapore Armed Forces</div>
                            <div class="exp-location">National Service</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <ul>
                            <li>Spearheaded signal operations for an entire combat engineer brigade.</li>
                            <li>Directed multiple military projects and tasks relating to information systems, networking and telecommunications.</li>
                            <li>Conducted and supported numerous cycles of signal training courses for national servicemen in-camp trainings.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
