---
import BaseLayout from '../layouts/BaseLayout.astro';
const withBase = (path) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
---

<BaseLayout title="About - Ryan Darius Lim">
    <div class="section" style="padding-top: 80px; background: #f8f9fa;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">About</h2>
                <p class="section-subtitle"> I am a Computing Student majoring in Business Analytics at the National University of Singapore. With a keen interest in fintech, strategy and analytics, I have immersed myself in these fields through projects, internships, competitions and events. 
                                                To widen my global perspective, I joined the NUS Overseas Colleges Paris programme, a stepping stone for me to explore vast cultures, the world over. Apart from all this, I want to positively impact the community and culture. 
                                                Below are some of the areas I have a heart for and a little bit more about me!
            </div>

            <div class="experience-grid">
                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">Pro Bono Consulting</div>
                            <div class="exp-company">180 Degrees Consulting (Kent Ridge)</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Providing strategic consulting services to non-profit organizations and social enterprises.</p>
                        <br>
                        <p>Worked with a sustainable fashion social enterprise, to optimise their marketing mix and execute a strategic end-of-life sales plan that maximised stock liquidation while staying true to their social mission.</p>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">Community Service</div>
                            <div class="exp-company">Food Runner for Rental Flat Residents</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Volunteer food delivery service supporting residents in rental flats.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Personal Interests</h2>
            </div>

            <div class="experience-grid">
                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">🎸 Music</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Self-taught guitarist with a passion for playing oldies and classic songs.</p>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">⚽ Sports & Fitness</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>Active in running, hiking, racquet sports, and football. Enjoy staying fit and competitive.</p>
                    </div>
                </div>

                <div class="experience-card">
                    <div class="exp-header">
                        <div class="exp-details">
                            <div class="exp-title">🎮 Gaming</div>
                        </div>
                    </div>
                    <div class="exp-content">
                        <p>GeoGuessr enthusiast and Supercell games fan. Love strategy and geography-based challenges.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Section -->
    <div class="section" style="background: #f8f9fa;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Get In Touch</h2>
                <p class="section-subtitle">Let's connect and discuss opportunities</p>
            </div>

            <div class="contact-boxes">
                <a href="mailto:ryandarius@u.nus.edu" class="contact-box">
                    <div class="contact-icon">📧</div>
                    <div class="contact-text">ryandarius@u.nus.edu</div>
                </a>
                <a href="https://linkedin.com/in/ryan-darius-lim/" target="_blank" class="contact-box">
                    <div class="contact-icon"><img src={withBase("linkedin_logo.png")} alt="LinkedIn"></div>
                    <div class="contact-text">ryan-darius-lim</div>
                </a>
                <a href="tel:+6587747874" class="contact-box">
                    <div class="contact-icon">📱</div>
                    <div class="contact-text">+65 8774 7874</div>
                </a>
            </div>
        </div>
    </div>
</BaseLayout>
