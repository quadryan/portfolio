---
import BaseLayout from '../../layouts/BaseLayout.astro';
const withBase = (path) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
---

<BaseLayout title="Shopee Returns & Refunds UX - Ryan Darius Lim">
    <div class="ux-projects" style="padding-top: 80px;">
        <div class="container">
            <div class="project-card">
                <div class="project-header">
                    <div class="project-title-row">
                        <img src={withBase("shopee_logo.png")} alt="Shopee logo" class="project-logo">
                        <h3 class="project-title">Shopee - Returns & Refunds UX</h3>
                    </div>
                    <p class="project-role">Operations Business Analyst Intern</p>
                    <p class="project-dates">Jun 2025 – Aug 2025 | Regional Operations</p>
                </div>

                <div class="project-content">
                    <!-- Project Scope -->
                    <div class="content-section">
                        <h4 class="content-section-title">Project Scope</h4>
                        <p>
                            <strong>Problem Statement:</strong> Reducing costs via streamlining of Return and Refund (RR) UX Entry Points.
                        </p>
                        <p>
                            The returns and refunds process had multiple entry points across the app, leading to unnecessarily high compensation costs. 
                            My task was to identify which entry points could be removed or consolidated without negatively impacting customer satisfaction.
                        </p>
                    </div>

                    <div class="project-image">
                        <img src={withBase("shopee_order.png")} alt="Shopee returns and refunds entry points">
                    </div>

                    <p style="margin: 10px 0; color: #586069;">
                        An example of a returns and refunds (RR) UX entry point on Shopee's mobile app, that was part of my analysis.
                    </p>

                    <!-- UX Research Process -->
                    <div class="content-section">
                        <h4 class="content-section-title">UX Research Process</h4>
                        
                        <div class="feature-grid">
                            <div class="feature-box">
                                <div class="feature-title">Quantitative: Competitive Benchmarking</div>
                                <div class="feature-description">
                                    Conducted comprehensive UX audit of returns/refunds flows across Lazada, Tiktok Shop, Taobao etc.
                                </div>
                            </div>
                            
                            <div class="feature-box">
                                <div class="feature-title">Qualitative: SQL Data Analysis</div>
                                <div class="feature-description">
                                    Queried complex datasets to analyze buyer behavior patterns across different entry points. 
                                    Identified cost drivers and analyzed correlations with customer satisfaction scores.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Key UX Findings -->
                    <div class="content-section">
                        <h4 class="content-section-title">Key UX Findings</h4>
                        
                        <div class="feature-grid">
                            <div class="feature-box">
                                <div class="feature-title">Redundant Entry Points</div>
                                <div class="feature-description">
                                    Multiple entry points serving the same function resulted in higher instances of users requesting for returns 
                                    and refunds and potentially created confusion for users.
                                </div>
                            </div>
                            
                            <div class="feature-box">
                                <div class="feature-title">Marginal Increase in Customer Satisfaction Scores upon adding a specific UX RR Entry point</div>
                                <div class="feature-description">
                                    A/B Testing Results showed that certain entry points did not significantly improve customer satisfaction, 
                                    indicating potential for removal without negative impact.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Methodology -->
                    <div class="content-section">
                        <h4 class="content-section-title">Methodology</h4>
                        
                        <p style="margin-bottom: 15px;"><strong>Data Analysis Approach:</strong></p>
                        <ul class="simple-list">
                            <li>Wrote complex SQL queries to extract and analyze millions of return/refund transactions across Asia and Brazil markets</li>
                            <li>Mapped user journey flows for each RR entry point to understand usage patterns and friction points</li>
                            <li>Segmented users by behavior, demographics, and satisfaction scores to identify patterns</li>
                            <li>Calculated cost-per-transaction for each entry point to quantify business impact</li>
                        </ul>

                        <p style="margin-top: 25px; margin-bottom: 15px;"><strong>Competitive Analysis:</strong></p>
                        <ul class="simple-list">
                            <li>Audited RR flows on Lazada, TikTok Shop, Taobao, and other major e-commerce platforms</li>
                            <li>Documented best practices and pain points from competitor implementations</li>
                            <li>Benchmarked Shopee's entry point complexity against industry standards</li>
                        </ul>
                    </div>

                    <!-- Results & Impact -->
                    <div class="content-section">
                        <h4 class="content-section-title">Results & Impact</h4>
                        
                        <div class="feature-grid">
                            <div class="feature-box">
                                <div class="feature-title">Cost Reduction</div>
                                <div class="feature-description">
                                    Strategic recommendations had potential to lower Shopee's compensation rate by up to 10%, 
                                    translating to significant cost savings across regional operations.
                                </div>
                            </div>
                            
                            <div class="feature-box">
                                <div class="feature-title">Operational Efficiency</div>
                                <div class="feature-description">
                                    Coordinated policy implementation across Asia and Brazil markets, reducing RR agent 
                                    judgment deviation to less than 25%.
                                </div>
                            </div>
                            
                            <div class="feature-box">
                                <div class="feature-title">User Experience</div>
                                <div class="feature-description">
                                    Simplified RR process maintained customer satisfaction while reducing operational complexity 
                                    and support burden.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Key Learnings -->
                    <div class="content-section">
                        <h4 class="content-section-title">Key Learnings</h4>
                        
                        <ul class="simple-list">
                            <li><strong>Data-Driven UX Decisions:</strong> Combined quantitative SQL analysis with qualitative competitive research to make informed recommendations backed by both user behavior data and industry benchmarks</li>
                            <li><strong>Balance User Needs & Business Goals:</strong> Found the sweet spot between customer convenience and operational efficiency by identifying truly redundant touchpoints</li>
                            <li><strong>Regional Complexity:</strong> Learned to account for market-specific behaviors and preferences when designing solutions for pan-Asian rollout</li>
                            <li><strong>Cross-Functional Collaboration:</strong> Worked closely with product, operations, and customer service teams to ensure feasibility and smooth implementation</li>
                        </ul>
                    </div>

                    <div class="tools">
                        <span class="tool-tag">SQL</span>
                        <span class="tool-tag">User Journey Mapping</span>
                        <span class="tool-tag">Competitive Analysis</span>
                        <span class="tool-tag">UX Audit</span>
                        <span class="tool-tag">Data Analysis</span>
                        <span class="tool-tag">A/B Testing Analysis</span>
                    </div>

                    <div style="margin-top: 40px; padding-top: 30px; border-top: 2px solid #e1e4e8;">
                        <a href={withBase("projects")} style="color: #0366d6; font-weight: 600;">← Back to All Projects</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
