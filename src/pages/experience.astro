---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Experience - Ryan Darius Lim">
    <div class="section" style="padding-top: 80px;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Experience</h2>
                <p class="section-subtitle">Internships spanning Fintech, AI startup, e-commerce, non-life reinsurance, and life insurance</p>
            </div>

            <div class="experience-grid">
                <!-- Airwallex -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/airwallex_logo.png" alt="Airwallex logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">AI Strategy Intern <span class="status-badge">Commencing Soon</span></div>
                            <div class="exp-company">Airwallex</div>
                            <div class="exp-dates">Dec 2025 – May 2026</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Airwallex is a global fintech unicorn providing businesses with international payments, foreign exchange, and expense management solutions. The company serves over 100,000 businesses worldwide.
                    </div>
                </div>

                <!-- Shopee -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/shopee_logo.png" alt="Shopee logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Operations Business Analyst Intern</div>
                            <div class="exp-company">Shopee (Sea Group)</div>
                            <div class="exp-dates">Jun 2025 – Aug 2025</div>
                            <div class="exp-location">Regional Operations, Returns & Refunds</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Shopee is Southeast Asia's leading e-commerce platform under Sea Group, serving millions of daily users across 7+ markets. The platform processes billions in GMV annually.
                    </div>
                    <div class="exp-content">
                        <p><strong>Project Problem Statement:</strong> Reducing costs via streamlining of Return and Refund (RR) UX Entry Points.</p>
                        <ul>
                            <li>Queried and analysed complex return & refund datasets using SQL to gain insights on buyer behaviour, strategized on which RR entry point should be removed, that lowered Shopee's compensation rate by up to 10%.</li>
                            <li>BAU: Coordinated implementation of policies across Asia+BR; reduced RR agent judgement deviation to &lt;25%.</li>
                        </ul>
                    </div>
                </div>

                <!-- Kleep AI -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/kleep_logo.png" alt="Kleep logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Founders' Associate, Product and Operations</div>
                            <div class="exp-company">Kleep AI</div>
                            <div class="exp-dates">Jan 2025 – Jun 2025</div>
                            <div class="exp-location">NOC Paris, France</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Kleep is an AI-powered size recommendation tool for fashion e-commerce, helping reduce return rates and increase conversions. The startup operates in Paris and partnered with Université PSL & NUS Overseas Colleges (NOC) Paris program.
                    </div>
                    <div class="exp-content">
                        <ul>
                            <li>Developed dashboards, data & sales funnels on GA4, Looker and Hubspot for startup's product and sales analytics.</li>
                            <li>Optimised and tested product UIUX for seamless integration on client websites; built the startup's website from scratch.</li>
                            <li>Streamlined operations and finances via automation and AI, generating 1,000 € a month in cost-savings for the startup.</li>
                        </ul>
                    </div>
                </div>

                <!-- Munich Re -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/munich_re_logo.png" alt="Munich Re logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Business Analyst Intern</div>
                            <div class="exp-company">Munich Re / Münchener Rück</div>
                            <div class="exp-dates">May 2024 – Aug 2024</div>
                            <div class="exp-location">Treaty Underwriting</div>
                        </div>
                    </div>
                    <div class="company-info">
                        Munich Re is the world's largest reinsurance company, providing risk solutions and insurance-related financial services globally with over €66 billion in annual premium income.
                    </div>
                    <div class="exp-content">
                        <ul>
                            <li>Designed and executed an analytics system from data input to visualisation, via Power BI dashboards, from scratch.</li>
                            <li>Programmed Excel Macros with VBA to automate underwriting data updates, saving up to 100 manhours a month.</li>
                            <li>Analysed natural catastrophe and macroeconomic trends in ASEAN, visualising them into slides for upper management.</li>
                        </ul>
                    </div>
                </div>

                <!-- AIA -->
                <div class="experience-card">
                    <div class="exp-header">
                        <img src="/aia_logo.png" alt="AIA logo" class="company-logo">
                        <div class="exp-details">
                            <div class="exp-title">Business Underwriting & Portfolio Management Trainee</div>
                            <div class="exp-company">AIA</div>
                            <div class="exp-dates">Dec 2022 – Jul 2023</div>
                            <div class="exp-location">Corporate Solutions</div>
                        </div>
                    </div>
                    <div class="company-info">
                        AIA is the largest pan-Asian life insurance group, providing insurance and financial services to millions of customers across 18 markets in the Asia-Pacific region.
                    </div>
                    <div class="exp-content">
                        <ul>
                            <li>Conducted User Acceptance Testing for a company-wide business transformation project, liaised with dev engineers.</li>
                            <li>Aggregated and analysed data using SQL and Microsoft Excel; wrote complex SQL scripts for data querying.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
